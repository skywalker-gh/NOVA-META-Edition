  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^22.0.0"
  },
  "build": {
