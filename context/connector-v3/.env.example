# Gateway process (Railway)
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
MCP_BEARER_TOKEN_HASH=replace-with-64-character-sha256-hex
WORKER_TOKEN_HASH=replace-with-64-character-sha256-hex

# Local Windows worker; use the generated wss:// Railway service URL.
GATEWAY_URL=wss://connector.example.up.railway.app/worker
WORKER_TOKEN=replace-with-a-long-random-secret
NOVA_PROJECT_ROOT=C:\Users\YOUR_USER\OneDrive\Desktop\Desktop\Nova V2
# CODEX_BIN=C:\Users\YOUR_USER\AppData\Local\OpenAI\Codex\bin\codex.exe
