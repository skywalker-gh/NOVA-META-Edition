# === NOVA Yggdrasil - Muse Connector ===
# Copy to .env and never commit!
META_API_KEY=meta_sk_...your_key_from_dev.meta.ai...
META_ENDPOINT=https://api.meta.ai/v1

# Optional models
MUSE_SPARK_MODEL=muse-spark
MUSE_WONDER_MODEL=muse-wonder-1.0
MUSE_CODE_MODEL=muse-code

# Canonical root (must match NOVA_PROJECT_ROOT)
NOVA_PROJECT_ROOT=/path/to/NOVA-Yggdrasil
NOVA_POSTGRES_DSN=postgresql://nova:nova@localhost:5432/nova