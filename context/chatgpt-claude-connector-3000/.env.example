# Anthropic API Key for Claude requests (required if using Claude tools)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI API Key for ChatGPT requests (required if using ChatGPT tools)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Optional: Local Nova project root path (defaults to current working directory)
NOVA_PROJECT_ROOT=.

# Optional: Canonical Nova Streamable-HTTP MCP endpoint URL and token
NOVA_MCP_URL=
NOVA_MCP_TOKEN=
