# xAI API Key for Grok requests (required)
XAI_API_KEY=xai-your-api-key-here

# Optional: Grok model (defaults to grok-4.7 if unset)
GROK_MODEL=grok-4.7

# Optional: Local Nova project root path (defaults to current working directory if unset)
NOVA_PROJECT_ROOT=.

# Optional: Canonical Nova Streamable-HTTP MCP endpoint URL and token
NOVA_MCP_URL=
NOVA_MCP_TOKEN=
